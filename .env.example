# ─────────────────────────────────────────────────────────────
# VeriTrace-X — Environment configuration (copy to .env)
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ── Backend / API ──
APP_ENV=development                 # development | production
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# ── Database ──
# Local dev defaults to SQLite (zero-setup). For production use Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/veritrace
DATABASE_URL=sqlite:///./veritrace.db

# ── ML ──
MODEL_ARTIFACT_PATH=ml/artifacts/model.joblib
MODEL_METADATA_PATH=ml/artifacts/model_meta.json

# ── Blockchain ──
# development  -> local hash-chained audit log (clearly labelled NOT on-chain)
# fabric       -> real Hyperledger Fabric network (requires network setup)
BLOCKCHAIN_MODE=development
FABRIC_CONNECTION_PROFILE=blockchain/network/connection.json
FABRIC_CHANNEL=veritrace-channel
FABRIC_CHAINCODE=veritrace-audit

# ── Frontend (Vite) ──
VITE_API_BASE_URL=http://localhost:8000
