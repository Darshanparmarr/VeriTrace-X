{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "comment": "Proxy API calls to the deployed backend. Replace the host with your backend URL.",
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-YOUR-BACKEND-HOST/api/:path*"
    },
    {
      "comment": "SPA fallback for client-side routing.",
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
